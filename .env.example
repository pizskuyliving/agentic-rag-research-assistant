# Salin file ini menjadi .env lalu isi key-nya. JANGAN commit file .env.

# --- LLM utama (wajib): https://console.groq.com/keys ---
GROQ_API_KEY=

# --- Cadangan (opsional; dipakai berurutan saat kuota Groq habis) ---
# NVIDIA (gratis, tanpa kartu, model sama gpt-oss-120b): https://build.nvidia.com -> Get API Key
NVIDIA_API_KEY=
# Cloudflare Workers AI (gratis 10.000 neurons/hari, tanpa kartu, gpt-oss-120b):
# dash.cloudflare.com -> AI -> Workers AI -> "Use REST API" -> Create API Token; Account ID ada di halaman yang sama
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
# Fireworks AI (gratis 10 permintaan/menit tanpa kartu, gpt-oss-120b): fireworks.ai -> API Keys
FIREWORKS_AI_API_KEY=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# https://console.mistral.ai/ (Nov 2026: paket gratis tidak lagi bisa memakai API key)
MISTRAL_API_KEY=

# --- Model per peran (nama model berubah dari waktu ke waktu; cek di console penyedia) ---
# llama-3.1-8b-instant sudah dimatikan Groq (16 Agustus 2026) -> pakai gpt-oss-20b
# Pilihan A (default): Groq utama
MODEL_RINGAN=groq/openai/gpt-oss-20b
MODEL_BERAT=groq/openai/gpt-oss-120b
# Pilihan B: NVIDIA utama (tanpa batas token harian, maks. ~40 permintaan/menit), Groq jadi cadangan
# MODEL_RINGAN=nvidia_nim/openai/gpt-oss-120b
# MODEL_BERAT=nvidia_nim/openai/gpt-oss-120b
REASONING_EFFORT=low
MODEL_CADANGAN_NVIDIA=nvidia_nim/openai/gpt-oss-120b
MODEL_CADANGAN_GROQ=groq/openai/gpt-oss-120b
MODEL_CADANGAN_CLOUDFLARE=cloudflare/@cf/openai/gpt-oss-120b
MODEL_CADANGAN_FIREWORKS=fireworks_ai/accounts/fireworks/models/gpt-oss-120b
MODEL_CADANGAN_GEMINI=gemini/gemini-3.5-flash-lite
MODEL_CADANGAN_MISTRAL=mistral/mistral-small-latest

# --- Embedding & vector DB ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=jurnal

# --- Chunking ---
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
TOP_K=5

# --- Model untuk node penilaian (grade & evaluasi): ringan | berat ---
# berat = lebih akurat menilai relevansi, tapi lebih lambat & memakai kuota model besar
PERAN_GRADE=berat
PERAN_EVALUASI=berat
